ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential clang lld cmake ninja-build pkg-config autoconf automake libtool \
    bison flex git curl ca-certificates xz-utils unzip zip patch gettext \
    python3 python3-dev python3-venv python3-pip nodejs npm cargo rustc golang-go \
    default-jdk-headless maven gradle ruby ruby-dev bundler php-cli composer \
    lua5.4 liblua5.4-dev luarocks ocaml opam ocaml-dune ghc cabal-install \
    elixir erlang-dev rebar3 mono-devel dotnet-sdk-8.0 \
    libssl-dev zlib1g-dev libzstd-dev libffi-dev libsqlite3-dev libxml2-dev \
    libxslt1-dev libgmp-dev libncurses-dev libreadline-dev libicu-dev libyaml-dev php-curl \
    libpcre2-dev libedit-dev libcurl4-openssl-dev libevent-dev \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/corpus/python && \
    echo 'tree-sitter==0.25.2 --hash=sha256:b43a9e4c89d4d0839de27cd4d6902d33396de700e9ff4c5ab7631f277a85ead9' > /opt/corpus/requirements.txt && \
    /opt/corpus/python/bin/pip install --no-cache-dir --only-binary=:all: --require-hashes -r /opt/corpus/requirements.txt
COPY toolchains.json install_toolchains.py /opt/corpus/
RUN python3 /opt/corpus/install_toolchains.py
ENV PATH=/opt/toolchains/node/bin:/opt/toolchains/go/bin:/opt/toolchains/rust/bin:${PATH}
COPY worker.py /opt/corpus/worker.py
RUN mkdir -p /input /out /work /opt/corpus/grammars /opt/corpus/servers && \
    dpkg-query -W > /opt/corpus/build-packages.tsv
WORKDIR /work
ENTRYPOINT ["python3", "/opt/corpus/worker.py"]
