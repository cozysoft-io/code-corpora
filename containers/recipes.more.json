{
  "vscode-ansible": {
    "kind": "pnpm",
    "before_build": [
      [
        "pnpm",
        "--recursive",
        "--workspace-concurrency=2",
        "--filter=@ansible/ansible-language-server...",
        "run",
        "compile"
      ]
    ],
    "node_bins": {
      "ansible-language-server": "packages/ansible-language-server/dist/cli.cjs"
    }
  },
  "some-sass": {
    "kind": "npm",
    "before_build": [
      [
        "npm",
        "--workspace=@somesass/vscode-css-languageservice",
        "run",
        "build:production"
      ],
      [
        "npm",
        "--workspace=@somesass/language-services",
        "run",
        "build:production"
      ],
      [
        "npm",
        "--workspace=some-sass-language-server",
        "run",
        "build:production"
      ]
    ],
    "node_bins": {
      "some-sass-language-server": "packages/language-server/bin/some-sass-language-server"
    }
  },
  "likec4": {
    "kind": "pnpm",
    "before_build": [
      [
        "pnpm",
        "--filter=@likec4/style-preset",
        "run",
        "sources"
      ],
      [
        "pnpm",
        "--recursive",
        "--workspace-concurrency=2",
        "--filter=@likec4/language-server...",
        "run",
        "build"
      ],
      [
        "pnpm",
        "--recursive",
        "--workspace-concurrency=2",
        "--filter=@likec4/lsp...",
        "run",
        "build"
      ]
    ],
    "node_bins": {
      "likec4-language-server": "packages/language-server/bin/likec4-language-server.mjs",
      "likec4-lsp": "packages/lsp/bin/likec4-lsp.mjs"
    }
  },
  "naive-ui-intellisense": {
    "kind": "npm",
    "npm_install_directories": [
      ".",
      "client",
      "server"
    ],
    "prepare_commands": [
      [
        "npm",
        "--prefix",
        "server",
        "run",
        "download"
      ]
    ],
    "before_build": [
      [
        "npm",
        "--prefix",
        "server",
        "run",
        "build"
      ]
    ],
    "node_bins": {
      "naive-ui-language-server": "server/dist/server.js"
    },
    "repair_lock": true,
    "repair_reason": "Selected package-lock omits declared build dependencies including rollup terser and cross-env; preserve both lockfiles"
  },
  "solargraph": {
    "kind": "bundler",
    "fetch_git": true,
    "ruby_bins": {
      "solargraph": "bin/solargraph"
    }
  },
  "psalm": {
    "kind": "composer"
  },
  "quint": {
    "kind": "npm",
    "directory": "vscode/quint-vscode/server",
    "script": "compile"
  },
  "devglobe-extension": {
    "kind": "npm",
    "directory": "devglobe-core",
    "script": "build"
  },
  "vscode-motoko": {
    "kind": "npm",
    "before_build": [
      [
        "npm",
        "run",
        "generate"
      ],
      [
        "npm",
        "run",
        "compile:pre"
      ],
      [
        "npm",
        "run",
        "compile:formatter"
      ],
      [
        "npm",
        "run",
        "compile:keywords"
      ],
      [
        "npm",
        "run",
        "compile:server"
      ],
      [
        "npm",
        "run",
        "compile:motoko"
      ]
    ],
    "node_bins": {
      "motoko-language-server": "out/server.js"
    }
  },
  "batch-language-server": {
    "kind": "commands",
    "prepare_commands": [
      [
        "git",
        "clone",
        "--no-checkout",
        "https://github.com/RechInformatica/rech-editor-batch.git",
        "/work/upstream"
      ],
      [
        "git",
        "-C",
        "/work/upstream",
        "checkout",
        "--detach",
        "fcce16377c726f95d5afd25d91a05cd29208e2a7"
      ],
      [
        "npm",
        "--prefix=/work/upstream",
        "ci",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund"
      ],
      [
        "npm",
        "install",
        "--prefix=/work/tools",
        "--ignore-scripts",
        "--no-audit",
        "--no-fund",
        "esbuild@0.28.1"
      ]
    ],
    "build_commands": [
      [
        "/work/tools/node_modules/.bin/esbuild",
        "/work/upstream/src/lsp/server.ts",
        "--bundle",
        "--platform=node",
        "--target=node18",
        "--format=cjs",
        "--outfile=/work/server.js"
      ]
    ],
    "outputs": [
      {
        "source": "/work/server.js",
        "name": "batch-language-server",
        "path": "server.js",
        "interpreter": "node"
      }
    ],
    "additional_sources": [
      {
        "url": "https://github.com/RechInformatica/rech-editor-batch",
        "sha": "fcce16377c726f95d5afd25d91a05cd29208e2a7",
        "reason": "Exact upstream pin in selected build.mjs"
      }
    ]
  },
  "matlab-language-server": {
    "kind": "npm",
    "npm_install_directories": [
      ".",
      "src/licensing/gui"
    ],
    "script": "compile"
  },
  "inlang-language-server": {
    "kind": "pnpm",
    "script": "pack"
  },
  "noir": {
    "kind": "cargo",
    "fetch_git": true,
    "cargo_packages": [
      "nargo_cli"
    ]
  },
  "kotlin-language-server": {
    "kind": "gradle",
    "fetch_git": true,
    "prepare_timeout": 1800,
    "gradle_tasks": [
      ":server:installDist"
    ],
    "outputs": [
      {
        "source": "server/build/install/server/bin/kotlin-language-server",
        "name": "kotlin-language-server",
        "path": "bin/kotlin-language-server"
      }
    ],
    "runtime_directories": [
      {
        "source": "server/build/install/server/lib",
        "path": "lib"
      }
    ]
  },
  "nil": {
    "kind": "cargo",
    "fetch_git": true
  },
  "zls": {
    "kind": "commands",
    "fetch_git": true,
    "submodules": true,
    "environment": {
      "ZIG_GLOBAL_CACHE_DIR": "/work/zig-cache",
      "ZIG_LOCAL_CACHE_DIR": "/work/zig-local"
    },
    "prepare_commands": [
      [
        "zig",
        "build",
        "--fetch",
        "-Doptimize=ReleaseSafe"
      ]
    ],
    "build_commands": [
      [
        "zig",
        "build",
        "-Doptimize=ReleaseSafe",
        "-j2"
      ]
    ],
    "outputs": [
      {
        "source": "zig-out/bin/zls",
        "name": "zls",
        "path": "zls"
      }
    ]
  },
