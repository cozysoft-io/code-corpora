  "lexical": {
    "kind": "commands",
    "fetch_git": true,
    "submodules": true,
    "environment": {
      "MIX_HOME": "/work/mix",
      "HEX_HOME": "/work/hex",
      "HEX_CACERTS_PATH": "/etc/ssl/certs/ca-certificates.crt",
      "ERL_FLAGS": "+S 2:2 +A 2",
      "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    },
    "prepare_commands": [
      [
        "mix",
        "local.hex",
        "--force"
      ],
      [
        "mix",
        "local.rebar",
        "--force"
      ],
      [
        "mix",
        "deps.get"
      ]
    ],
    "build_commands": [
      [
        "env",
        "HEX_OFFLINE=1",
        "mix",
        "package",
        "--path",
        "/work/distribution"
      ]
    ],
    "runtime_directories": [
      {
        "source": "/work/distribution",
        "path": "package"
      }
    ],
    "outputs": [
      {
        "source": "/work/distribution/bin/start_lexical.sh",
        "path": "package/bin/start_lexical.sh",
        "name": "lexical"
      }
    ]
  },
  "elixir-ls": {
    "kind": "commands",
    "fetch_git": true,
    "submodules": true,
    "environment": {
      "MIX_ENV": "prod",
      "MIX_HOME": "/work/mix",
      "HEX_HOME": "/work/hex",
      "HEX_CACERTS_PATH": "/etc/ssl/certs/ca-certificates.crt",
      "ERL_FLAGS": "+S 2:2 +A 2"
    },
    "prepare_commands": [
      [
        "mix",
        "local.hex",
        "--force"
      ],
      [
        "mix",
        "local.rebar",
        "--force"
      ],
      [
        "mix",
        "deps.get"
      ]
    ],
    "build_commands": [
      [
        "env",
        "HEX_OFFLINE=1",
        "mix",
        "compile"
      ],
      [
        "python3",
        "-c",
        "from pathlib import Path; Path(\"/work/elixir-ls\").write_text('#!/bin/sh\\nexport MIX_ENV=prod MIX_HOME=/opt/corpus/servers/elixir-ls/mix HEX_HOME=/work/home/hex HEX_OFFLINE=1 ERL_FLAGS=\"+S 2:2 +A 2\"\\ncd /opt/corpus/servers/elixir-ls/package\\nexec mix run --no-start --no-compile --no-deps-check --no-halt -e \"ElixirLS.LanguageServer.main()\"\\n')"
      ]
    ],
    "runtime_directories": [
      {
        "source": ".",
        "path": "package"
      },
      {
        "source": "/work/mix",
        "path": "mix"
      }
    ],
    "outputs": [
      {
        "source": "/work/elixir-ls",
        "path": "elixir-ls",
        "name": "elixir-ls"
      }
    ]
  },
  "python-lsp-server": {
    "kind": "python",
    "fetch_git": true
  },
  "arkts": {
    "kind": "pnpm",
    "before_build": [
      [
        "pnpm",
        "--filter=ohos-typescript",
        "run",
        "build:compiler"
      ],
      [
        "python3",
        "-c",
        "from pathlib import Path; import shutil; p=Path(\"ohos-typescript\"); built=p/\"built/local\"; assert (built/\"typescript.js\").is_file(); shutil.copytree(built,p/\"lib\",dirs_exist_ok=True)"
      ],
      [
        "pnpm",
        "--recursive",
        "--workspace-concurrency=2",
        "--filter=@arkts/language-server...",
        "run",
        "build"
      ]
    ],
    "node_bins": {
      "ets-language-server": "packages/language-server/bin/ets-language-server.js"
    },
    "fetch_git": true,
    "submodules": true,
    "submodule_urls": {
      "ohos-typescript": "https://github.com/openharmony/third_party_typescript"
    },
    "prepare_timeout": 1800
  },
  "flow-cli": {
