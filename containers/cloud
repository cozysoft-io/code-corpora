#!/usr/bin/env python3
"""Run trusted administrative commands on this project's build VM."""
import json
from pathlib import Path
import subprocess
import sys

config = json.loads(Path(__file__).with_name('cloud.json').read_text())
command = ['gcloud', 'compute', 'ssh', config['instance'],
           '--project='+config['project'], '--zone='+config['zone'],
           '--tunnel-through-iap', '--quiet']
if len(sys.argv) > 1:
    command += ['--command', sys.argv[1]]
raise SystemExit(subprocess.call(command))
