        "build"
      ]
    ],
    "node_bins": {
      "tsm-language-server": "packages/language-server/bin/tsm-language-server.js"
    }
  },
  "tsrx": {
    "kind": "pnpm",
    "before_build": [
      [
        "pnpm",
        "--recursive",
        "--workspace-concurrency=2",
        "--filter=@tsrx/language-server...",
        "run",
        "build"
      ]
