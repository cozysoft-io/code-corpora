  "vscode-containers": {
    "kind": "pnpm",
    "before_build": [
      [
        "pnpm",
        "--recursive",
        "--workspace-concurrency=2",
        "--filter=@microsoft/compose-language-service...",
        "run",
        "build"
      ]
    ],
    "node_bins": {
      "docker-compose-langserver": "packages/compose-language-service/bin/docker-compose-langserver"
    }
  },
  "vscode-ansible": {
    "kind": "pnpm",
    "before_build": [
      [
        "pnpm",
        "--recursive",
        "--workspace-concurrency=2",
        "--filter=@ansible/ansible-language-server...",
        "run",
        "compile"
      ]
    ],
    "node_bins": {
      "ansible-language-server": "packages/ansible-language-server/dist/cli.cjs"
    }
  },
  "coffeesense": {
    "kind": "npm",
    "npm_install_directories": [
      ".",
      "server"
    ],
    "before_build": [
      [
        "npm",
        "--prefix",
        "server",
        "run",
        "compile"
      ]
    ],
    "node_bins": {
      "coffeesense-language-server": "server/bin/coffeesense-language-server"
    }
  },
  "stimulus-lsp": {
    "kind": "npm",
    "npm_install_directories": [
      ".",
      "client",
      "server"
    ],
    "before_build": [
      [
        "./node_modules/.bin/tsc",
        "-b"
      ],
      [
        "node",
        "server/scripts/executable.mjs"
      ]
    ],
    "node_bins": {
      "stimulus-language-server": "server/out/stimulus-language-server"
    }
  },
  "vscode-stylelint": {
    "kind": "npm",
    "before_build": [
      [
        "npm",
        "--workspace=@stylelint/language-server",
        "run",
        "build"
      ]
    ],
    "node_bins": {
      "stylelint-language-server": "packages/language-server/bin/stylelint-language-server.mjs"
    }
  },
  "vscode-antlers-language-server": {
    "kind": "npm",
    "npm_install_directories": [
      ".",
      "client",
      "server"
    ],
    "script": "bundle:antlersls",
    "node_bins": {
      "antlersls": "antlersls/server.js"
    }
  },
  "some-sass": {
    "kind": "npm",
    "before_build": [
      [
        "npm",
        "--workspace=some-sass-language-server",
        "run",
        "build:production"
      ]
    ],
    "node_bins": {
      "some-sass-language-server": "packages/language-server/bin/some-sass-language-server"
    }
  },
  "naive-ui-intellisense": {
    "kind": "npm",
    "npm_install_directories": [
      ".",
      "client",
      "server"
    ],
    "prepare_commands": [
      [
        "npm",
        "--prefix",
        "server",
        "run",
        "download"
      ]
    ],
    "before_build": [
      [
        "npm",
        "--prefix",
        "server",
        "run",
        "build"
      ]
    ],
    "node_bins": {
      "naive-ui-language-server": "server/dist/server.js"
    }
  },
  "tact-language-server": {
    "kind": "npm",
    "script": "build",
    "node_bins": {
      "tact-language-server": "dist/server.js"
    }
  },
  "ton-language-server": {
    "kind": "npm",
    "script": "build",
    "node_bins": {
      "ton-language-server": "dist/server.js"
    }
  }
}
