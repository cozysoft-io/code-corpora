{
  "arkts": {
    "kind": "pnpm",
    "before_build": [
      [
        "pnpm",
        "--recursive",
        "--workspace-concurrency=2",
        "--filter=@arkts/language-server...",
        "run",
        "build"
      ]
    ],
    "node_bins": {
      "ets-language-server": "packages/language-server/bin/ets-language-server.js"
    }
  },
  "astro": {
    "kind": "pnpm",
    "before_build": [
      [
        "pnpm",
        "--recursive",
        "--workspace-concurrency=2",
        "--filter=@astrojs/language-server...",
        "run",
        "build"
      ]
    ],
    "node_bins": {
      "astro-ls": "packages/language-tools/language-server/bin/nodeServer.js"
    }
  },
  "dep-beacon": {
    "kind": "pnpm",
